function [t, P] = rk4_method(f, tspan, P0, h)
    t = tspan(1):h:tspan(2);
    P = zeros(size(t));
    P(1) = P0;

    for i = 1:length(t)-1
        k1 = f(t(i),         P(i));
        k2 = f(t(i) + h/2,   P(i) + h/2 * k1);
        k3 = f(t(i) + h/2,   P(i) + h/2 * k2);
        k4 = f(t(i) + h,     P(i) + h   * k3);

        P(i+1) = P(i) + (h/6) * (k1 + 2*k2 + 2*k3 + k4);
    end
end
